# Optional overrides for praxedis-technologies.service.
# Copy to /etc/praxedis-technologies/praxedis-technologies.env and edit;
# anything set here wins over the Environment= lines in the unit. Nothing in
# this file belongs in git.
#
#   sudo install -d -m 0755 /etc/praxedis-technologies
#   sudo install -o root -g root -m 0640 systemd/praxedis-technologies.env.example \
#     /etc/praxedis-technologies/praxedis-technologies.env
#
# ADMIN_SESSION_SECRET is required for the /admin dashboard to accept
# sign-ins. scripts/deploy.sh generates one here if this file has none;
# generate one by hand with:  openssl rand -base64 48

# ADMIN_SESSION_SECRET=

HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=www.praxedistechnologies.com,praxedistechnologies.com,127.0.0.1,localhost
KV_PATH=/var/lib/praxedis-technologies/site.kv
